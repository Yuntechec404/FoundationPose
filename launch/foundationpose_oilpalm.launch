<launch>
  <!-- ===================== 基本輸入 (Topics / Frames) ===================== -->
  <arg name="image_topic"      default="/camera/color/image_raw"/> <!-- RGB 影像 topic -->
  <arg name="info_topic"       default="/camera/color/camera_info"/> <!-- RGB 相機內參 -->
  <arg name="depth_topic"      default="/camera/aligned_depth_to_color/image_raw"/> <!-- 對齊 RGB 的深度影像 -->
  <arg name="depth_info_topic" default="/camera/aligned_depth_to_color/camera_info"/> <!-- 深度相機內參 -->
  <arg name="camera_tf"        default="camera_color_optical_frame"/> <!-- 相機座標系 TF -->
  <arg name="object_name"      default="oilpalm"/> <!-- 目標物名稱（用於 log / debug / topic 命名） -->
  
  <!-- ===================== 模型與系統設定 ===================== -->
  <arg name="mesh_file"        default="$(find ros_foundationpose)/data/oilpalm/oilpalm.obj"/> <!-- 3D mesh (用於 pose estimation) -->
  <arg name="debug_dir"        default="$(find ros_foundationpose)/log"/> <!-- debug 輸出資料夾 -->
  <arg name="perf_eval_enable" default="true"/> <!-- 是否啟用效能評估 -->
  <arg name="seg_backend"      default="bbox"/> <!-- segmentation backend (bbox / yolo11-seg / sam / sam2) -->
  
  <!-- ===================== YOLO / YOLO-seg ===================== -->
  <!-- <arg name="det_model"        default="$(find ros_foundationpose)/data/bunch_stem-seg.onnx"/>  -->
  <!-- YOLO segmentation 模型 -->
  <arg name="det_model"        default="$(find ros_foundationpose)/data/oilpalm_stem.onnx"/> 
  <!-- YOLO detection 模型 -->

  <!-- ===================== SAM / SAM2 ===================== -->
  <arg name="sam_model"        default="sam_h"/> 
  <!-- SAM (sam_h / sam_l / sam_b / mobile_sam) -->
  <!-- <arg name="sam_ckpt"         default="$(find ros_foundationpose)/data/sam/sam_vit_h_4b8939.pth"/>  -->
  <!-- SAM 權重路徑 -->
  <arg name="sam_ckpt"         default="$(find ros_foundationpose)/data/sam2/sam2_t.pt"/> 
  <!-- SAM2 (sam2_t.pt / sam2_s.pt / sam2_b.pt / sam2_l.pt / sam2.1_t.pt / sam2.1_s.pt / sam2.1_b.pt / sam2.1_l.pt) -->
  
  <!-- ===================== 初始化策略 ===================== -->
  <arg name="init_mode"        default="yolo"/> <!-- 初始化方式：yolo / click -->
  <arg name="yolo_start_mode"  default="immediate"/> <!-- YOLO 啟動模式：immediate / wait -->
  
  <!-- ===================== Detection 參數 ===================== -->
  <arg name="det_conf"         default="0.25"/> <!-- detection confidence threshold -->
  <arg name="det_class"        default="0"/> <!-- 使用的類別 ID -->
  <arg name="det_imgsz"        default="640"/> <!-- 輸入 YOLO 的影像大小 -->
  <arg name="det_select_mode"  default="score"/> <!-- bbox 選擇策略：middle | score |nearest_depth -->
  
  <!-- ===================== Pose Estimation / Tracking ===================== -->
  <arg name="est_refine_iter"  default="5"/> <!-- 初始化 pose refine 次數 -->
  <arg name="track_refine_iter" default="2"/> <!-- tracking 時 refine 次數 -->
  
  <!-- ===================== ROI / IoU 控制 ===================== -->
  <arg name="roi_expand"       default="0.01"/> <!-- ROI 擴張比例 -->
  <arg name="iou_stride"       default="3"/> <!-- IoU 計算的採樣間距 -->
  <arg name="iou_thresh"       default="0.1"/> <!-- IoU 門檻（低於此值視為 tracking 失敗） -->
  <arg name="iou_patience"     default="3"/> <!-- 容忍連續失敗次數 -->
  
  <!-- ===================== 視覺化顯示 ===================== -->
  <arg name="show_depth_window" default="false"/> <!-- 是否顯示深度視窗 -->
  <arg name="show_rgb_window"   default="true"/> <!-- 是否顯示 RGB 視窗 -->
  <arg name="depth_win_name"    default="Depth"/> <!-- 深度視窗名稱 -->
  <arg name="rgb_win_name"      default="RGB"/> <!-- RGB 視窗名稱 -->
  <arg name="depth_window_xy"   default="[100, 100]"/> <!-- 深度視窗位置 -->
  <arg name="rgb_window_xy"     default="[100, 500]"/> <!-- RGB 視窗位置 -->
  <arg name="max_depth_mm"      default="2000.0"/> <!-- 最大顯示深度（mm） -->
  <arg name="colormap"          default="2"/> <!-- OpenCV colormap 類型 -->
  <arg name="invert_colormap"   default="false"/> <!-- 是否反轉 colormap -->
  
  <!-- ===================== Post-processing (姿態驗證 / 過濾) ===================== -->
  <arg name="pp_enable"               default="false"/> <!-- 是否啟用後處理過濾 -->
  <arg name="pp_up_axis"              default="y"/> <!-- 物體的「上方向」軸 -->
  <arg name="pp_expect_orientation"   default="inverted"/> <!-- 預期姿態（upright/ inverted） -->
  <arg name="pp_orient_center_tol_px" default="20.0"/> <!-- 姿態中心容許誤差（pixel） -->
 
  <!-- ===================== 尺寸驗證 ===================== -->
  <arg name="pp_size_mode"        default="bbox_mm"/> <!-- 尺寸判斷模式（bbox_mm / depth） -->
  <arg name="pp_expect_bbox_w_mm" default="115.0"/> <!-- 預期 bbox 寬度（mm） -->
  <arg name="pp_expect_bbox_h_mm" default="80.0"/> <!-- 預期 bbox 高度（mm） -->
  <arg name="pp_size_ratio_min"   default="0.6"/> <!-- 尺寸比例最小值（過小視為錯誤） -->
  
  <!-- ===================== 深度驗證 ===================== -->
  <arg name="pp_expect_depth_m"   default="1.2"/> <!-- 預期深度（m） -->
  <arg name="pp_depth_tol_m"      default="0.25"/> <!-- 深度容忍誤差 -->
  <arg name="pp_retry_delay_sec"  default="1.0"/> <!-- 失敗後 retry 間隔 -->

  <!-- ===================== Node ===================== -->
  <node pkg="ros_foundationpose" type="foundationpose_tracker.py" name="foundationpose_tracker" output="screen">

    <!-- Topics -->
    <param name="image_topic"      value="$(arg image_topic)"/>
    <param name="info_topic"       value="$(arg info_topic)"/>
    <param name="depth_topic"      value="$(arg depth_topic)"/>
    <param name="depth_info_topic" value="$(arg depth_info_topic)"/>
    <param name="camera_tf"        value="$(arg camera_tf)"/>
    <param name="object_name"      value="$(arg object_name)"/>

    <!-- Model / Backend -->
    <param name="perf_eval_enable" value="$(arg perf_eval_enable)"/>
    <param name="seg_backend"      value="$(arg seg_backend)"/>
    <param name="sam_model"        value="$(arg sam_model)"/>
    <param name="sam_ckpt"         value="$(arg sam_ckpt)"/>
    <param name="det_model"        value="$(arg det_model)"/>
    <param name="mesh_file"        value="$(arg mesh_file)"/>
    <param name="debug_dir"        value="$(arg debug_dir)"/>

    <!-- Init / Detection -->
    <param name="init_mode"        value="$(arg init_mode)"/>
    <param name="yolo_start_mode"  value="$(arg yolo_start_mode)"/>
    <param name="det_conf"         value="$(arg det_conf)"/>
    <param name="det_class"        value="$(arg det_class)"/>
    <param name="det_imgsz"        value="$(arg det_imgsz)"/>
    <param name="det_select_mode"  value="$(arg det_select_mode)"/>

    <!-- Tracking -->
    <param name="est_refine_iter"   value="$(arg est_refine_iter)"/>
    <param name="track_refine_iter" value="$(arg track_refine_iter)"/>

    <!-- IoU / ROI -->
    <param name="roi_expand"    value="$(arg roi_expand)"/>
    <param name="iou_stride"    value="$(arg iou_stride)"/>
    <param name="iou_thresh"    value="$(arg iou_thresh)"/>
    <param name="iou_patience"  value="$(arg iou_patience)"/>

    <!-- Visualization -->
    <param name="show_depth_window" value="$(arg show_depth_window)"/>
    <param name="show_rgb_window"   value="$(arg show_rgb_window)"/>
    <param name="depth_win_name"    value="$(arg depth_win_name)"/>
    <param name="rgb_win_name"      value="$(arg rgb_win_name)"/>
    <param name="depth_window_xy"   value="$(arg depth_window_xy)" type="yaml"/>
    <param name="rgb_window_xy"     value="$(arg rgb_window_xy)" type="yaml"/>
    <param name="max_depth_mm"      value="$(arg max_depth_mm)"/>
    <param name="colormap"          value="$(arg colormap)"/>
    <param name="invert_colormap"   value="$(arg invert_colormap)"/>
    
    <!-- Post-processing -->
    <param name="postproc/enable"               value="$(arg pp_enable)"/>
    <param name="postproc/up_axis"              value="$(arg pp_up_axis)"/>
    <param name="postproc/expect_orientation"   value="$(arg pp_expect_orientation)"/>
    <param name="postproc/orient_center_tol_px" value="$(arg pp_orient_center_tol_px)"/>

    <param name="postproc/size_mode"        value="$(arg pp_size_mode)"/>
    <param name="postproc/expect_bbox_w_mm" value="$(arg pp_expect_bbox_w_mm)"/>
    <param name="postproc/expect_bbox_h_mm" value="$(arg pp_expect_bbox_h_mm)"/>
    <param name="postproc/size_ratio_min"   value="$(arg pp_size_ratio_min)"/>

    <param name="postproc/expect_depth_m"   value="$(arg pp_expect_depth_m)"/>
    <param name="postproc/depth_tolerance_m" value="$(arg pp_depth_tol_m)"/>
    <param name="postproc/retry_delay_sec"  value="$(arg pp_retry_delay_sec)"/>

  </node>
</launch>
