<launch>
  <arg name="image_topic" default="/camera/color/image_raw"/>
  <arg name="info_topic" default="/camera/color/camera_info"/>
  <arg name="depth_topic" default="/camera/aligned_depth_to_color/image_raw"/>
  <!-- 彩色影像、對齊後的深度圖、相機內參的Topic -->
  <arg name="camera_tf" default="camera_color_optical_frame"/>
  <!-- 相機的TF座標系 -->
  <arg name="fruit_name" default="oilpalm"/>
  <arg name="frond_name" default="frond"/>
  
  <arg name="mesh_file" default="$(find ros_foundationpose)/data/oilpalm/oilpalm.obj"/> 
  <!-- 果串的 3D 模型檔 (.obj) -->
  <arg name="debug_dir" default="$(find ros_foundationpose)/log"/>
  <arg name="self_eval_log" default="false"/>

  <arg name="det_model" default="$(find ros_foundationpose)/data/oilpalm_stem_new.onnx"/>
  <!-- YOLO detection模型的權重檔 -->
  <arg name="seg_model" default="$(find ros_foundationpose)/data/oilpalm_stem-seg.pt"/>
  <!-- YOLOv11-seg模型的權重路徑 -->
  <arg name="sam_ckpt" default="$(find ros_foundationpose)/data/sam/sam_b.pt"/>
  <!-- SAM模型的權重路徑 -->
  <arg name="sam2_ckpt" default="$(find ros_foundationpose)/data/sam2/sam2.1_l.pt"/>
  <!-- SAM2模型的權重路徑 -->
  <arg name="fastsam_ckpt" default="$(find ros_foundationpose)/data/fastsam/FastSAM-s.pt"/>
  <!-- FastSAM模型的權重路徑 -->

  <arg name="yolo_start_mode" default="wait"/>
  <!-- immediate or wait -->
  <arg name="fruit_pipeline_mode" default="2"/> 
  <!-- 1: YOLO + SAM; 2: YOLO + SAM2; 3: YOLO + FastSAM; 4: YOLO11-seg -->
  <arg name="frond_pipeline_mode" default="2"/> 
  <!-- 1: YOLO + SAM + Cutie; 2: YOLO + SAM2 + Cutie; 3: YOLO + FastSAM + Cutie; 4: YOLO + SAM2 -->

  <arg name="det_conf" default="0.25"/>
  <!-- YOLO 的信心度閾值 -->
  <arg name="det_imgsz" default="640"/>
  <arg name="det_select_mode" default="nearest_depth"/>
  <!-- YOLO的挑選策略 score / middle / nearest_depth -->
  <arg name="cls_fruit" default="0"/>
  <arg name="cls_frond" default="1"/>

  <arg name="init_det_patience" default="15"/>
  <!-- YOLO 需連續穩定偵測 N 幀，才進行分割與 FoundationPose 初始化。 -->
  <arg name="est_top_k" default="40"/>
  <!-- FoundationPose 初始化保留的最佳候選姿態數。 -->
  <arg name="est_refine_iter" default="5"/>
  <!-- 初始對齊時的優化迭代次數 -->
  <arg name="track_refine_iter" default="2"/>
  <!-- 連續追蹤時的迭代次數 -->

  <!-- ===================== Coarse Initial Pose Sampling ===================== -->
  <arg name="coarse_min_n_views"              default="40"/> <!-- icosphere 最少視角數；40 通常會產生 42 個視角 -->
  <arg name="coarse_inplane_step"             default="60"/> <!-- 平面內旋轉間隔；60=6 rotations，30=12 rotations -->
  <arg name="coarse_orientation_mode"         default="inverted"/> <!-- uniform / upright / inverted -->
  <arg name="coarse_orientation_tilt_deg"     default="80.0"/> <!-- 正放/倒放允許傾斜角度，單位 deg -->
  <arg name="coarse_object_up_axis"           default="1"/> <!-- 0=X, 1=Y, 2=Z；目前定義綠色 Y 軸為判斷軸 -->

  <arg name="roi_expand" default="0.01"/>
  <!-- FoundationPose 深度幾何自我評估：MAE 越低越好，Inlier Ratio 越高越好。 -->
  <arg name="geom_mae_thresh" default="0.2"/>
  <!-- MAE > 此值，視為重新初始化候選，單位 m。 -->
  <arg name="geom_inlier_thresh" default="0.35"/>
  <!-- Inlier Ratio < 此值，視為重新初始化候選。 -->
  <arg name="occ_mae_thresh" default="0.05"/>
  <!-- MAE <= 此值且 Inlier Ratio >= occ_inlier_thresh，視為低遮蔽。 -->
  <arg name="occ_inlier_thresh" default="0.9"/>
  <!-- 介於重新初始化門檻與低遮蔽門檻之間，視為高遮蔽。 -->
  <arg name="geom_patience" default="5"/>
  <!-- 連續 N 幀為重新初始化候選時，以目前 Cutie mask 重新註冊 FoundationPose，並同時判為高遮蔽。 -->
  <arg name="policy_high_patience" default="3"/>
  <!-- 連續高遮蔽 N 幀後切換至 frond 模式。 -->

  <arg name="show_depth_window" default="false"/>
  <arg name="show_rgb_window" default="true"/>
  <arg name="depth_win_name" default="Depth"/>
  <arg name="rgb_win_name" default="RGB"/>
  <arg name="depth_window_xy" default="[100,100]"/>
  <arg name="rgb_window_xy" default="[100,500]"/>
  <arg name="max_depth_mm" default="2000.0"/>
  <arg name="colormap" default="2"/>
  <arg name="invert_colormap" default="false"/>

  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <!-- 預測葉莖在畫面中的新位置 -->
  <arg name="frond_lost" default="3.0"/>
  <arg name="frond_depth_min" default="0.1"/>
  <arg name="frond_depth_max" default="3.0"/>
  <!-- 葉莖有效深度的上下限 -->
  <arg name="frond_assumed_radius" default="0.0"/>
  <!-- 深度圖只能拍到表面，假設葉莖半徑為N公尺，以求得真正的中心點 -->
  <arg name="max_jump_m" default="0.06"/>
  <!-- 限制兩幀之間葉莖 3D 座標的最大移動距離 -->
  <arg name="ema_alpha" default="0.6"/>
  <!-- 指數移動平均 (EMA) 濾波系數 (0~1之間) -->
 
  <node pkg="ros_foundationpose" type="pipeline_tracker.py" name="pipeline_tracker" output="screen">
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="info_topic" value="$(arg info_topic)"/>
    <param name="depth_topic" value="$(arg depth_topic)"/>
    <param name="camera_tf" value="$(arg camera_tf)"/>
    <param name="fruit_name" value="$(arg fruit_name)"/>
    <param name="frond_name" value="$(arg frond_name)"/>

    <param name="det_model" value="$(arg det_model)"/>
    <param name="mesh_file" value="$(arg mesh_file)"/>
    <param name="debug_dir" value="$(arg debug_dir)"/>

    <param name="yolo_start_mode" value="$(arg yolo_start_mode)"/>
    <param name="det_conf" value="$(arg det_conf)"/>
    <param name="det_imgsz" value="$(arg det_imgsz)"/>
    <param name="det_select_mode" value="$(arg det_select_mode)"/>
    <param name="init_det_patience" value="$(arg init_det_patience)"/>

    <param name="est_top_k" value="$(arg est_top_k)"/>
    <param name="est_refine_iter" value="$(arg est_refine_iter)"/>
    <param name="track_refine_iter" value="$(arg track_refine_iter)"/>

    <param name="coarse/min_n_views" value="$(arg coarse_min_n_views)"/>
    <param name="coarse/inplane_step" value="$(arg coarse_inplane_step)"/>
    <param name="coarse/orientation_mode" value="$(arg coarse_orientation_mode)"/>
    <param name="coarse/orientation_tilt_deg" value="$(arg coarse_orientation_tilt_deg)"/>
    <param name="coarse/object_up_axis" value="$(arg coarse_object_up_axis)"/>

    <param name="roi_expand" value="$(arg roi_expand)"/>
    <param name="self_eval_log" value="$(arg self_eval_log)"/>
    <param name="geom_mae_thresh" value="$(arg geom_mae_thresh)"/>
    <param name="geom_inlier_thresh" value="$(arg geom_inlier_thresh)"/>
    <param name="occ_mae_thresh" value="$(arg occ_mae_thresh)"/>
    <param name="occ_inlier_thresh" value="$(arg occ_inlier_thresh)"/>
    <param name="geom_patience" value="$(arg geom_patience)"/>

    <param name="show_depth_window" value="$(arg show_depth_window)"/>
    <param name="show_rgb_window" value="$(arg show_rgb_window)"/>
    <param name="depth_win_name" value="$(arg depth_win_name)"/>
    <param name="rgb_win_name" value="$(arg rgb_win_name)"/>
    <param name="depth_window_xy" value="$(arg depth_window_xy)" type="yaml"/>
    <param name="rgb_window_xy" value="$(arg rgb_window_xy)" type="yaml"/>
    <param name="max_depth_mm" value="$(arg max_depth_mm)"/>
    <param name="colormap" value="$(arg colormap)"/>
    <param name="invert_colormap" value="$(arg invert_colormap)"/>

    <param name="postproc/fruit/pipeline_mode" value ="$(arg fruit_pipeline_mode)"/>

    <param name="postproc/frond/pipeline_mode" value ="$(arg frond_pipeline_mode)"/>
    <param name="postproc/frond/cmd_vel_topic" value="$(arg cmd_vel_topic)" />
    <param name="postproc/frond/frond_lost" value="$(arg frond_lost)" />
    <param name="postproc/frond/frond_depth_min" value="$(arg frond_depth_min)" />
    <param name="postproc/frond/frond_depth_max" value="$(arg frond_depth_max)" />
    <param name="postproc/frond/frond_assumed_radius" value="$(arg frond_assumed_radius)" />
    <param name="postproc/frond/max_jump_m" value="$(arg max_jump_m)" />
    <param name="postproc/frond/ema_alpha" value="$(arg ema_alpha)" />

    <param name="classes/fruit" value ="$(arg cls_fruit)"/>
    <param name="classes/frond" value ="$(arg cls_frond)"/>
    <param name="policy/high_patience" value ="$(arg policy_high_patience)"/>

    <param name="postproc/seg_model" value ="$(arg seg_model)"/>
    <param name="postproc/sam_ckpt" value ="$(arg sam_ckpt)"/>
    <param name="postproc/sam2_ckpt" value ="$(arg sam2_ckpt)"/>
    <param name="postproc/fastsam_ckpt" value ="$(arg fastsam_ckpt)"/>
    <param name="postproc/seg_imgsz" value ="$(arg det_imgsz)"/>
  </node>
</launch>
